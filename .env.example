# Copy to .env and fill in. The .env file is git-ignored.

# sample = read the fixture files in integrations/sample (no Fabric needed)
# fabric = read the wh_gold warehouse with the service principal below
DATA_SOURCE=sample

# Local passwords for the containers (choose your own)
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Weather sync
SYNC_INTERVAL_MINUTES=60
SYNC_LOOKBACK_DAYS=100

# Telegram bot (leave the token empty to run without the bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Fabric warehouse access, only for DATA_SOURCE=fabric
FABRIC_SQL_ENDPOINT=
FABRIC_WAREHOUSE=wh_gold
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=
